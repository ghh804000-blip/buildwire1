<?xml version="1.0" encoding="utf-8"?>
<!-- The audio plugin downloads a package with nuget.exe while building for Windows. This supplies the package source for this project only. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
